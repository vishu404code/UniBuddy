# Copy to backend/.env and fill in on your own machine. Never commit the real file.
# Every value below is a placeholder. Real values belong only in private settings.

APP_NAME=UniBuddy Backend
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Neon PostgreSQL with pgvector (server-side only) ---
# Use a non-superuser role that is granted the roles from app/db/bootstrap. See docs/SETUP.md.
DATABASE_URL=postgresql://replace-user:replace-password@replace-host/replace-db?sslmode=require

# --- UniBuddy session tokens (server-side only, at least 32 random characters) ---
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Google sign-in (the client ID is public; never put a client secret here) ---
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com

# --- Cloudflare R2 for private PDFs (server-side only) ---
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET=unibuddy-documents

# --- Google Gemini (server-side only; API cost and data-sharing apply) ---
GEMINI_API_KEY=replace-with-your-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# --- Document processing and retrieval ---
DOCUMENT_WORKER_ENABLED=true
MAX_UPLOAD_BYTES=20971520
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3
API_V1_PREFIX=/api/v1
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
DOCUMENT_WORKER_POLL_SECONDS=5.0
DOCUMENT_WORKER_BATCH_SIZE=3
DOCUMENT_LEASE_SECONDS=600
DOCUMENT_MAX_ATTEMPTS=3
