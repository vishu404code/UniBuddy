# Copy this file to backend/.env and fill in real values locally.
# .env is git-ignored. Never commit real secrets, never paste them into chat,
# and never put them in the frontend.
# tests/test_config_template.py fails if this file and app/config.py drift apart.

# --- App ---
APP_NAME=UniBuddy Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
# Comma-separated origins allowed to call this API (the frontend's URL).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Supabase (Project Settings > API) ---
# Project URL, shape https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret API key, starts with sb_secret_. Server-side only. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-key
# Publishable key, starts with sb_publishable_. Used for requests made on behalf of a user,
# so RLS applies. Safe to expose, but keep it in this file.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-key
# Private Storage bucket for uploaded PDFs.
SUPABASE_STORAGE_BUCKET=documents

# --- Backend selection (keep supabase until the replacement is verified) ---
DATA_BACKEND=supabase
AUTH_BACKEND=supabase
STORAGE_BACKEND=supabase

# --- Replacement database and sign-in (server-side only; not used while the backends above are supabase) ---
DATABASE_URL=postgresql://replace-user:replace-password@replace-host/replace-db?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com

# --- Cloudflare R2 (server-side only; not used until the Stage 2 migration) ---
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET=unibuddy-documents

# --- Google Gemini (server-side only; API cost and data-sharing apply, see backend/README.md) ---
GEMINI_API_KEY=replace-with-your-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite


# --- Documents and ingestion ---
MAX_UPLOAD_BYTES=20971520
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# --- Retrieval (starting points; tune against real campus documents) ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3

# --- Document worker (processes queued uploads) ---
# true: the worker runs inside the web process (development).
# false: the web service does not run it; use `python -m app.worker` as a separate process (production).
DOCUMENT_WORKER_ENABLED=true
DOCUMENT_WORKER_POLL_SECONDS=5.0
DOCUMENT_WORKER_BATCH_SIZE=3
# A claim whose worker stopped is taken again after this many seconds.
DOCUMENT_LEASE_SECONDS=600
# Temporary failures are retried until this many attempts, then the document is marked failed.
DOCUMENT_MAX_ATTEMPTS=3
