# Copy this file to .env and fill in real values locally.
# .env is git-ignored. Never commit real secrets or paste them into chat.

APP_NAME=UniBuddy Backend
APP_ENV=development

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project URL (Dashboard > Project Settings > API > Project URL).
# Example shape only: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side secret (Dashboard > Project Settings > API > service_role).
# Bypasses RLS. Keep it only in your local .env and in the Render environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Added in later milestones (not used yet) ---
# OPENAI_API_KEY=
