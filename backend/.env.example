# Copy this file to .env and fill in real values locally.
# .env is git-ignored. Never commit real secrets or paste them into chat.

APP_NAME=UniBuddy Backend
APP_ENV=development

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project URL (Project Settings > API > Project URL).
# Shape: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret API key (starts with sb_secret_). Server-side only.
# Bypasses row-level security. Never put it in the frontend, a commit or a log.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-key

# --- Added in later milestones (not used yet) ---
# OPENAI_API_KEY=
