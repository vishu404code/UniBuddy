# Copy this file to .env and fill in real values locally.
# .env is git-ignored. Never commit real secrets or paste them into chat.

APP_NAME=UniBuddy Backend
APP_ENV=development

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project URL (Project Settings > API > Project URL).
# Shape: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret API key (starts with sb_secret_). Server-side only.
# Bypasses row-level security. Never put it in the frontend, a commit or a log.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-key

# Supabase publishable key (starts with sb_publishable_). Used for requests made
# on behalf of a signed-in user, so RLS applies. Safe to expose, but keep it here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-key

# Private Storage bucket for uploaded PDFs. Create it once; see backend/README.md.
SUPABASE_STORAGE_BUCKET=documents

# OpenAI API key (Server-side only). Used for embeddings and answer generation.
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Retrieval starting points. Tune against real campus documents.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3
